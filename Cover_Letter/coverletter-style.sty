% ATS-friendly cover letter style, matching resume-style.sty's visual identity
% Single column, no tables/graphics/icons/text-boxes, real selectable text only.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{coverletter-style}[2026/07/29 ATS-friendly cover letter style v1]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[margin=0.5in]{geometry}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{ragged2e}
\RequirePackage{enumitem}

% TeX Gyre Heros: same free, pdfTeX-native Helvetica-equivalent used in the
% resume, for correct ToUnicode text-extraction and visual brand consistency.
\RequirePackage{tgheros}
\renewcommand{\familydefault}{\sfdefault}

% ---- Same color palette as resume-style.sty ----
\definecolor{accent}{RGB}{27,71,110}
\definecolor{accentrule}{RGB}{158,181,201}
\definecolor{ink}{RGB}{40,40,40}
\definecolor{subtext}{RGB}{100,100,100}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}
\RaggedRight
\color{ink}

\hypersetup{
  colorlinks=true,
  linkcolor=accent,
  urlcolor=accent,
}

% ---- Header (mirrors \cvname/\cvtitle/\cvcontact) ----
\newcommand{\clname}[1]{%
  {\fontsize{18}{20}\selectfont\bfseries\color{accent} #1}\par\vspace{1pt}
}
\newcommand{\cltitle}[1]{%
  {\fontsize{10.5}{12}\selectfont\bfseries\color{accent} #1}\par\vspace{3pt}
}
\newcommand{\clcontact}[2]{%
  {\small\color{ink} #1}\par\vspace{1pt}
  {\small\color{ink} #2}\par\vspace{4pt}
  {\color{accent}\rule{\linewidth}{0.9pt}}\vspace{6pt}
}

% ---- Date / recipient block ----
\newcommand{\cldate}[1]{{\small\color{subtext} #1}\par\vspace{5pt}}
\newcommand{\clrecipient}[1]{{\small\color{ink} #1}\par\vspace{6pt}}

% ---- Key-highlights bullet list ----
\newlist{clitems}{itemize}{1}
\setlist[clitems]{
  leftmargin=14pt,
  itemsep=2pt,
  topsep=2pt,
  parsep=0pt,
  label={\color{accent}\textbullet}
}
\newcommand{\clhighlight}[2]{\textbf{\color{ink}#1 --- }#2}

% ---- Signature block ----
\newcommand{\clclosing}[4]{%
  #1\par\vspace{3pt}
  \textbf{\color{ink}#2}\par
  {\small\color{subtext}#3}\par
  {\small\color{subtext}#4}
}

\endinput
